diff --git a/templates/nginx-admin.conf b/templates/nginx-admin.conf
index 4528640..9d229d6 100644
--- a/templates/nginx-admin.conf
+++ b/templates/nginx-admin.conf
@@ -3,10 +3,11 @@
 # Only addresses in /etc/5cs045/admin-allow.conf may connect (change them on the panel's
 # Security page, or with: sudo /usr/local/sbin/5cs045/bin/admin-allow.sh). Everyone else gets 403
 # before any PHP runs, and the panel then asks for the sudo account's password.
+# It answers on fullstack.heraldcollege.edu.np and the bare IP, never on the students' name.
 server {
-    listen 8443 ssl;
-    listen [::]:8443 ssl;
-    server_name _;
+    listen 8443 ssl default_server;
+    listen [::]:8443 ssl default_server;
+    server_name _ fullstack.heraldcollege.edu.np;
 
     ssl_certificate     /etc/nginx/ssl/5cs045-selfsigned.crt;
     ssl_certificate_key /etc/nginx/ssl/5cs045-selfsigned.key;
@@ -39,3 +40,14 @@ server {
         fastcgi_read_timeout 120s;
     }
 }
+
+# fullstack-student.heraldcollege.edu.np is only for students' websites, so on this port it refuses
+# the secure connection and the browser shows no page at all.
+server {
+    listen 8443 ssl;
+    listen [::]:8443 ssl;
+    server_name fullstack-student.heraldcollege.edu.np;
+    ssl_reject_handshake on;
+    # A request that names this host after connecting under another name is simply dropped
+    return 444;
+}
