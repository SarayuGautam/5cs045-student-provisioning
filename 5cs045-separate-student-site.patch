@@ -104,6 +100,50 @@ a{color:#000;text-underline-offset:3px}
         }
     }
 
+    # Nothing else is on this name: no sign-up page, phpMyAdmin or admin panel
+    location / {
+        return 404;
+    }
+}
+
+# Sign-up and phpMyAdmin: https://fullstack.heraldcollege.edu.np/ (and the bare IP)
+server {
+    listen 443 ssl default_server;
+    listen [::]:443 ssl default_server;
+    server_name _ fullstack.heraldcollege.edu.np;
+
+    ssl_certificate     /etc/nginx/ssl/5cs045-selfsigned.crt;
+    ssl_certificate_key /etc/nginx/ssl/5cs045-selfsigned.key;
+    root /var/www/html;
+
+    add_header X-Content-Type-Options nosniff always;
+    add_header Referrer-Policy no-referrer always;
+
+    location ^~ /.well-known/acme-challenge/ {
+        allow all;
+        root /var/www/html;
+    }
+
+    location ~ /\. {
+        deny all;
+        return 404;
+    }
+
+    location = /smtp_config.php {
+        deny all;
+        return 404;
+    }
+
+    location /lib/ {
+        deny all;
+        return 404;
+    }
+
+    # Students' websites have their own name. Old links to them here still get there.
+    location ~ ^/~ {
+        return 301 https://fullstack-student.heraldcollege.edu.np$request_uri;
+    }
+
