# /etc/sudoers.d/5cs045-admin
# The admin panel's PHP (user 5cs045-admin) may run this one program as root, and nothing else.
# admin-action authenticates the signed-in Linux account itself and checks the root-owned
# panel-role allowlist before doing anything privileged.
5cs045-admin ALL=(root) NOPASSWD: /usr/local/sbin/5cs045/bin/admin-action