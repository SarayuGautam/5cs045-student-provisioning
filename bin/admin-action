#!/usr/bin/php
<?php
declare(strict_types=1);

// The only way the admin panel changes anything on the server.
//
// The panel runs as the unprivileged user 5cs045-admin and may run exactly this program
// through sudo (templates/sudoers-5cs045-admin). The request arrives as JSON on stdin:
//   {"action": "...", "token": "...", "ip": "...", "args": {...}}
// and the answer goes out as JSON on stdout: {"ok": true, "data": ...} or {"ok": false, "error": "..."}.
//
// Everything except "login" needs a token, which only "login" hands out after checking
// a fullstack or explicitly granted panel-admin account's password and role. The panel's
// own unprivileged user never receives the authority to choose a root action.
//
// Background jobs (smoke test, bulk add, remove everyone) run as:  admin-action --job <id>

// Warnings must never mix into the JSON answer on stdout
ini_set('display_errors', 'stderr');

const DEPLOY_ROOT = '/usr/local/sbin/5cs045';
const STUDENT_ROOT = '/srv/students';
const WEB_LIB = '/var/www/html/lib';
const SMTP_CONFIG = '/etc/5cs045/smtp_config.php';
const AUTH_DIR = '/var/lib/5cs045-admin-auth';
const ADMIN_USERS_FILE = AUTH_DIR . '/admin-users';
const PANEL_ACCOUNTS_DIR = AUTH_DIR . '/accounts';
const JOB_DIR = '/var/lib/5cs045-admin-jobs';
const ADMIN_LOG = '/var/log/5cs045-admin.log';
const ALLOW_FILE = '/etc/5cs045/admin-allow.conf';
const REGISTRY_DIR = '/var/lib/5cs045-registrations';
const CRED_DIR = '/var/lib/5cs045-credentials';
const DB_OVER_DIR = '/var/lib/5cs045-db-over';
const QUOTA_OVERRIDE_DIR = '/var/lib/5cs045-quota-overrides';
const STUDENT_ACCESS_TOOL = DEPLOY_ROOT . '/bin/student-access.sh';
const CLEAR_FOLDER_TOOL = DEPLOY_ROOT . '/bin/clear-student-folder.sh';
const DEFAULT_QUOTA_MB = 500;
const DB_LIMIT_MB = 100;
const IDLE_TIMEOUT = 1800;
const MAX_SESSION = 12 * 3600;
const MAX_FAILS = 5;
const FAIL_WINDOW = 900;
const USERNAME_RE = '/^[a-z][a-z0-9_]{2,31}$/';

const LOGS = [
    'registration' => '/var/log/5cs045-registration.log',
    'provisioning' => '/var/log/5cs045-provisioning.log',
    'admin' => ADMIN_LOG,
];

const SERVICES = [
    'nginx',
    'php8.3-fpm',
    'mariadb',
    'ssh',
    'fail2ban',
    'cron',
    'systemd-logind'
];

// ---------------------------------------------------------------------------------------------
// Plumbing

function reply(mixed $data): never {
    echo json_encode(
        ['ok' => true, 'data' => $data],
        JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE
    );
    exit(0);
}

function refuse(string $message): never {
    echo json_encode(
        ['ok' => false, 'error' => $message],
        JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE
    );
    exit(0);
}

/** Runs a command without a shell. Returns [exit code, stdout, stderr]. */
function run(array $cmd, ?string $stdin = null): array {
    $proc = proc_open(
        $cmd,
        [
            0 => ['pipe', 'r'],
            1 => ['pipe', 'w'],
            2 => ['pipe', 'w'],
        ],
        $pipes
    );

    if (!is_resource($proc)) {
        return [127, '', 'could not start ' . $cmd[0]];
    }

    if ($stdin !== null) {
        fwrite($pipes[0], $stdin);
    }

    fclose($pipes[0]);

    $out = stream_get_contents($pipes[1]);
    $err = stream_get_contents($pipes[2]);

    fclose($pipes[1]);
    fclose($pipes[2]);

    return [
        proc_close($proc),
        (string) $out,
        (string) $err
    ];
}

function audit(string $who, string $ip, string $what): void {
    $line = sprintf(
        "[%s] [%s] %s: %s\n",
        date('c'),
        $ip,
        $who,
        $what
    );

    @file_put_contents(
        ADMIN_LOG,
        $line,
        FILE_APPEND | LOCK_EX
    );

    @chmod(ADMIN_LOG, 0600);
}

function arg(array $args, string $name, string $default = ''): string {
    $v = $args[$name] ?? $default;

    return is_scalar($v)
        ? trim((string) $v)
        : $default;
}

function student_or_refuse(string $user): string {
    if (!preg_match(USERNAME_RE, $user)) {
        refuse('That is not a valid username.');
    }

    $pw = posix_getpwnam($user);

    if (
        $pw === false ||
        !str_starts_with(
            (string) $pw['dir'],
            STUDENT_ROOT . '/'
        )
    ) {
        refuse("There is no student called {$user}.");
    }

    return $user;
}

function smtp(): array {
    $c = @include SMTP_CONFIG;

    return is_array($c) ? $c : [];
}

function send_mail(
    string $to,
    string $subject,
    string $body,
    ?string $htmlBody = null
): ?string {
    require_once WEB_LIB . '/smtp_mailer.php';

    $c = smtp();

    try {
        $mailer = new SmtpMailer(
            host: (string) ($c['host'] ?? ''),
            port: (int) ($c['port'] ?? 587),
            username: (string) ($c['username'] ?? ''),
            password: (string) ($c['password'] ?? ''),
            fromAddress: (string) ($c['from_address'] ?? ''),
            fromName: (string) (
                $c['from_name'] ?? '5CS045 Student Server'
            ),
            useStartTls: (bool) (
                $c['use_starttls'] ?? true
            ),
        );

        $mailer->send(
            $to,
            $subject,
            $body,
            $htmlBody
        );

        return null;
    } catch (Throwable $e) {
        return $e->getMessage();
    }
}

function send_credentials(
    string $user,
    string $email
): ?string {
    require_once WEB_LIB . '/credentials.php';

    $password = saved_password($user);

    if ($password === null) {
        return 'No saved password for this student. Reset the password first.';
    }

    $serverUrl = site_url();

    return send_mail(
        $email,
        'Your Server Credentials',
        credentials_email_body(
            $user,
            $password,
            $serverUrl
        ),
        credentials_email_html(
            $user,
            $password,
            $serverUrl
        )
    );
}

/** The students' websites, as the login emails give them: their name, never an IP address. */
function site_url(): string {
    require_once WEB_LIB . '/credentials.php';

    return student_site_url(smtp());
}

function saved_password(string $user): ?string {
    $raw = @file_get_contents(
        CRED_DIR . '/' . $user
    );

    return (
        $raw !== false &&
        preg_match('/^PASSWORD=(\S+)/m', $raw, $m)
    ) ? $m[1] : null;
}

function student_folder_access(string $user): array {
    [$code, $out, $err] = run([
        STUDENT_ACCESS_TOOL,
        'get',
        $user
    ]);

    if ($code !== 0) {
        refuse(
            'Could not read folder access: ' .
            trim($err ?: $out)
        );
    }

    $data = [
        'workshop_weeks' => 1,
        'exam_mode' => 'open',
        'exam_at' => 0,
        'assessment_mode' => 'open',
        'assessment_at' => 0
    ];

    foreach (explode("\n", trim($out)) as $line) {
        if (preg_match('/^([a-z_]+)=(.*)$/', $line, $m)) {
            $key = $m[1];
            if (array_key_exists($key, $data)) {
                $data[$key] = in_array($key, ['workshop_weeks', 'exam_at', 'assessment_at'], true)
                    ? (int) $m[2]
                    : $m[2];
            }
        }
    }

    return [
        'workshop_weeks' => max(1, min(52, (int) $data['workshop_weeks'])),
        'exam' => [
            'mode' => in_array($data['exam_mode'], ['open', 'locked', 'scheduled'], true) ? $data['exam_mode'] : 'open',
            'at' => max(0, (int) $data['exam_at'])
        ],
        'assessment' => [
            'mode' => in_array($data['assessment_mode'], ['open', 'locked', 'scheduled'], true) ? $data['assessment_mode'] : 'open',
            'at' => max(0, (int) $data['assessment_at'])
        ]
    ];
}

function set_student_folder_access(
    string $user,
    int $weeks,
    string $examMode,
    int $examAt,
    string $assessmentMode,
    int $assessmentAt
): void {
    if ($weeks < 1 || $weeks > 52) {
        refuse('Choose between 1 and 52 workshop weeks.');
    }

    if (!in_array($examMode, ['open', 'locked', 'scheduled'], true)) {
        refuse('Choose a valid Exam access mode.');
    }

    if (!in_array($assessmentMode, ['open', 'locked', 'scheduled'], true)) {
        refuse('Choose a valid Assessment access mode.');
    }

    [$code, $out, $err] = run([
        STUDENT_ACCESS_TOOL,
        'set',
        $user,
        (string) $weeks,
        $examMode,
        (string) $examAt,
        $assessmentMode,
        (string) $assessmentAt
    ]);

    if ($code !== 0) {
        refuse(
            'Could not save folder access: ' .
            trim($err ?: $out)
        );
    }
}

function valid_email(string $email): bool {
    return (
        filter_var(
            $email,
            FILTER_VALIDATE_EMAIL
        ) !== false &&
        !preg_match(
            '/["\\\\\s]/',
            $email
        )
    );
}

/** Remembers a student's email next to their registration, so the panel can show and reuse it. */
function remember_email(
    string $user,
    string $email
): void {
    require_once WEB_LIB . '/credentials.php';

    @mkdir(
        REGISTRY_DIR,
        0700,
        true
    );

    $path =
        REGISTRY_DIR . '/' .
        registration_key($email);

    $record = is_file($path)
        ? (
            json_decode(
                (string) file_get_contents($path),
                true
            ) ?: []
        )
        : [];

    $record += [
        'username' => $user,
        'registered_at' => date(DATE_ATOM),
        'status' => 'complete'
    ];

    $record['email'] = strtolower($email);

    file_put_contents(
        $path,
        json_encode(
            $record,
            JSON_UNESCAPED_SLASHES
        ),
        LOCK_EX
    );

    chmod($path, 0600);

    @chown($path, 'www-data');
    @chgrp($path, 'www-data');
}

/** PHP reloads after the answer has gone back, because a reload ends the request that asked for it. */
function reload_later(): void {
    $script =
        'systemctl daemon-reload; systemctl reload php8.3-fpm';

    if (is_dir('/run/systemd/system')) {
        run([
            'systemd-run',
            '--quiet',
            '--collect',
            '--on-active=5s',
            '/bin/sh',
            '-c',
            $script
        ]);
    }
}

// ---------------------------------------------------------------------------------------------
// Panel roles and signing in

function admin_users(): array {
    $users = [];

    foreach (@file(ADMIN_USERS_FILE, FILE_IGNORE_NEW_LINES | FILE_SKIP_EMPTY_LINES) ?: [] as $line) {
        $user = trim($line);
        if (preg_match('/^[a-z_][a-z0-9_-]{0,31}$/', $user)) {
            $users[$user] = true;
        }
    }

    $users = array_keys($users);
    sort($users, SORT_NATURAL);
    return $users;
}

function admin_role(string $user): string {
    if ($user === 'fullstack') {
        return 'superadmin';
    }

    return in_array($user, admin_users(), true) ? 'admin' : '';
}

function write_admin_users(array $users): void {
    $users = array_values(array_unique(array_filter(
        $users,
        fn($u) => preg_match('/^[a-z_][a-z0-9_-]{0,31}$/', (string) $u)
    )));
    sort($users, SORT_NATURAL);

    file_put_contents(
        ADMIN_USERS_FILE,
        $users ? implode("\n", $users) . "\n" : '',
        LOCK_EX
    );
    chmod(ADMIN_USERS_FILE, 0600);
}

function invalidate_user_sessions(string $user): void {
    foreach (glob(AUTH_DIR . '/sessions/*') ?: [] as $file) {
        $session = json_decode((string) @file_get_contents($file), true);
        if (is_array($session) && ($session['user'] ?? '') === $user) {
            @unlink($file);
        }
    }
}

function panel_account_exists(string $user): bool {
    if (!preg_match('/^[a-z_][a-z0-9_-]{0,31}$/', $user)) {
        return false;
    }

    $pw = posix_getpwnam($user);
    return $pw !== false
        && (int) $pw['uid'] >= 1000
        && !str_starts_with((string) $pw['dir'], STUDENT_ROOT . '/');
}

function admin_panel_url(): string {
    $config = smtp();
    $url = rtrim(trim((string) ($config['admin_panel_url'] ?? '')), '/');
    $host = trim((string) parse_url($url, PHP_URL_HOST), '[]');

    if (
        $url === '' ||
        $host === '' ||
        filter_var($host, FILTER_VALIDATE_IP) !== false
    ) {
        return 'https://fullstack.heraldcollege.edu.np:8443';
    }

    return $url;
}

function admin_credentials_email_body(
    string $username,
    string $password
): string {
    return "Your 5CS045 admin-panel account is ready.\n\n" .
        "Admin panel: " . admin_panel_url() . "\n" .
        "Username: {$username}\n" .
        "Password: {$password}\n\n" .
        "Role: Students and Server (admin)\n\n" .
        "Keep this email private. Do not forward the password. " .
        "The fullstack account is the superadmin.\n";
}

function admin_credentials_email_html(
    string $username,
    string $password
): string {
    $safeUsername = htmlspecialchars($username, ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8');
    $safePassword = htmlspecialchars($password, ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8');
    $safePanel = htmlspecialchars(admin_panel_url(), ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8');

    return <<<HTML
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>5CS045 admin-panel account</title>
</head>
<body style="font-family:Arial,sans-serif;line-height:1.5;color:#222">
  <p>Your 5CS045 admin-panel account is ready.</p>
  <p><strong>Admin panel:</strong> <a href="{$safePanel}">{$safePanel}</a></p>
  <table cellpadding="6" cellspacing="0" border="0">
    <tr><td><strong>Username</strong></td><td>{$safeUsername}</td></tr>
    <tr><td><strong>Password</strong></td><td>{$safePassword}</td></tr>
    <tr><td><strong>Role</strong></td><td>Students and Server (admin)</td></tr>
  </table>
  <p>Keep this email private and do not forward the password.</p>
  <p>The <strong>fullstack</strong> account is the superadmin.</p>
</body>
</html>
HTML;
}

function panel_account_file(string $user): string {
    return PANEL_ACCOUNTS_DIR . '/' . $user . '.json';
}

function panel_accounts(): array {
    $accounts = [];

    foreach (glob(PANEL_ACCOUNTS_DIR . '/*.json') ?: [] as $file) {
        $record = json_decode((string) @file_get_contents($file), true);
        if (!is_array($record) || !isset($record['username'])) {
            continue;
        }

        $username = (string) $record['username'];
        if (!preg_match('/^[a-z_][a-z0-9_-]{0,31}$/', $username)) {
            continue;
        }

        $record['role'] = admin_role($username);
        $accounts[] = $record;
    }

    usort($accounts, fn(array $a, array $b): int =>
        strnatcasecmp((string) $a['username'], (string) $b['username'])
    );

    return $accounts;
}

function panel_password(): string {
    $chars = 'abcdefghijkmnopqrstuvwxyzABCDEFGHJKLMNPQRSTUVWXYZ23456789!@#$%^&*';
    $password = '';

    for ($i = 0; $i < 20; $i++) {
        $password .= $chars[random_int(0, strlen($chars) - 1)];
    }

    return $password;
}

function create_panel_account(array $args, string $admin, string $ip): array {
    $username = arg($args, 'username');
    $fullName = arg($args, 'full_name');
    $email = strtolower(arg($args, 'email'));
    $grantAdmin = !empty($args['grant_admin']);

    if (!preg_match('/^[a-z_][a-z0-9_-]{2,31}$/', $username)) {
        refuse('Username must be 3-32 lowercase letters, numbers, _ or -, starting with a letter or _.');
    }

    if ($username === 'fullstack') {
        refuse('The fullstack account is reserved for the superadmin.');
    }

    if ($email !== '' && !valid_email($email)) {
        refuse('That email address does not look right.');
    }

    if (posix_getpwnam($username) !== false) {
        refuse("The username {$username} already exists.");
    }

    @mkdir(PANEL_ACCOUNTS_DIR, 0700, true);

    $password = panel_password();
    $comment = $fullName !== '' ? $fullName : '5CS045 admin panel account';

    [$code, $out, $err] = run([
        'useradd',
        '--create-home',
        '--shell',
        '/bin/bash',
        '--comment',
        $comment,
        $username
    ]);

    if ($code !== 0) {
        refuse('Could not create that server account: ' . trim($err ?: $out));
    }

    [$code, $out, $err] = run(
        ['chpasswd'],
        $username . ':' . $password . "\n"
    );

    if ($code !== 0) {
        run(['userdel', '-r', $username]);
        refuse('The server account could not be given a password: ' . trim($err ?: $out));
    }

    $record = [
        'username' => $username,
        'full_name' => $fullName,
        'email' => $email,
        'created_by' => $admin,
        'created_at' => date(DATE_ATOM),
    ];

    file_put_contents(
        panel_account_file($username),
        json_encode($record, JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE),
        LOCK_EX
    );
    chmod(panel_account_file($username), 0600);

    if ($grantAdmin) {
        $users = admin_users();
        if (!in_array($username, $users, true)) {
            $users[] = $username;
            write_admin_users($users);
        }
    }

    $emailError = null;
    if ($grantAdmin && $email !== '') {
        $emailError = send_mail(
            $email,
            'Your 5CS045 admin-panel account',
            admin_credentials_email_body($username, $password),
            admin_credentials_email_html($username, $password)
        );
    }

    audit(
        $admin,
        $ip,
        'created non-student account ' . $username .
        ($grantAdmin ? ' with admin-panel access' : '') .
        ($email !== '' && $grantAdmin
            ? ($emailError === null ? ' and emailed credentials' : ' but credential email failed')
            : '')
    );

    return [
        'username' => $username,
        'password' => $password,
        'email' => $email,
        'admin' => $grantAdmin,
        'email_sent' => $grantAdmin && $email !== '' && $emailError === null,
        'email_error' => $emailError
    ];
}

function delete_panel_account(string $username, string $admin, string $ip): void {
    if (!is_file(panel_account_file($username))) {
        refuse('That account was not created through the admin panel.');
    }

    if ($username === 'fullstack') {
        refuse('The fullstack account cannot be removed from the panel.');
    }

    $pw = posix_getpwnam($username);
    if ($pw === false || str_starts_with((string) $pw['dir'], STUDENT_ROOT . '/')) {
        refuse('That is not a removable non-student account.');
    }

    $users = array_values(array_filter(
        admin_users(),
        fn(string $user): bool => $user !== $username
    ));
    write_admin_users($users);
    invalidate_user_sessions($username);

    [$code, $out, $err] = run(['userdel', '--remove', $username]);
    if ($code !== 0) {
        refuse('The account could not be removed: ' . trim($err ?: $out));
    }

    @unlink(panel_account_file($username));

    audit($admin, $ip, "removed non-student account {$username}");
}

function fail_file(
    string $kind,
    string $key
): string {
    return AUTH_DIR .
        '/fails-' .
        $kind .
        '-' .
        hash('sha256', $key);
}

function recent_fails(string $file): array {
    $now = time();

    $times = array_filter(
        array_map(
            'intval',
            @file(
                $file,
                FILE_IGNORE_NEW_LINES
            ) ?: []
        ),
        fn($t) => $now - $t < FAIL_WINDOW
    );

    return array_values($times);
}

function do_login(
    array $args,
    string $ip
): never {
    $user = arg($args, 'username');
    $password = (string) ($args['password'] ?? '');

    @mkdir(
        AUTH_DIR . '/sessions',
        0700,
        true
    );

    $files = [
        fail_file('user', $user),
        fail_file('ip', $ip)
    ];

    foreach ($files as $f) {
        $fails = recent_fails($f);

        if (count($fails) >= MAX_FAILS) {
            $wait = (int) ceil(
                (FAIL_WINDOW - (time() - min($fails))) / 60
            );

            refuse(
                "Too many wrong passwords. Try again in {$wait} minute" .
                ($wait === 1 ? '' : 's') .
                '.'
            );
        }
    }

    $ok = false;
    $role = admin_role($user);

    $pw =
        preg_match(
            '/^[a-z_][a-z0-9_-]{0,31}$/',
            $user
        )
        ? posix_getpwnam($user)
        : false;

    if (
        $role !== '' &&
        $pw !== false &&
        (int) $pw['uid'] >= 1000 &&
        !str_starts_with((string) $pw['dir'], STUDENT_ROOT . '/')
    ) {
        [, $shadow] = run(['getent', 'shadow', $user]);
        $hash = explode(':', trim($shadow))[1] ?? '';

        if ($hash !== '' && !in_array($hash[0], ['!', '*'], true)) {
            [, $match] = run(
                [
                    'perl',
                    '-e',
                    'chomp(my $p = <STDIN>); chomp(my $h = <STDIN>); print((crypt($p, $h) // "") eq $h ? "yes" : "no");'
                ],
                $password . "\n" . $hash . "\n"
            );

            $ok = $match === 'yes';
        }
    }

    if (!$ok) {
        foreach ($files as $f) {
            file_put_contents($f, time() . "\n", FILE_APPEND | LOCK_EX);
        }

        audit(
            $user !== '' ? $user : '?',
            $ip,
            'FAILED sign-in'
        );

        refuse(
            'Wrong username or password, or this account has not been granted admin-panel access.'
        );
    }

    foreach ($files as $f) {
        @unlink($f);
    }

    $token = bin2hex(random_bytes(32));

    $session = [
        'user' => $user,
        'role' => $role,
        'ip' => $ip,
        'created' => time(),
        'seen' => time()
    ];

    file_put_contents(
        AUTH_DIR . '/sessions/' . hash('sha256', $token),
        json_encode($session)
    );

    audit($user, $ip, 'signed in');

    reply([
        'token' => $token,
        'user' => $user,
        'role' => $role
    ]);
}

function check_token(
    string $token,
    string $ip
): string {
    $file =
        AUTH_DIR .
        '/sessions/' .
        hash('sha256', $token);

    $s =
        preg_match(
            '/^[a-f0-9]{64}$/',
            $token
        ) &&
        is_file($file)
            ? json_decode(
                (string) file_get_contents($file),
                true
            )
            : null;

    $now = time();
    $role = is_array($s)
        ? admin_role((string) ($s['user'] ?? ''))
        : '';

    if (!is_array($s) || $role === '') {
        if (is_file($file)) {
            unlink($file);
        }

        refuse(is_array($s) ? 'ADMIN_ACCESS_REVOKED' : 'SESSION_EXPIRED');
    }

    if (
        ($s['ip'] ?? '') !== $ip ||
        $now - (int) $s['seen'] > IDLE_TIMEOUT ||
        $now - (int) $s['created'] > MAX_SESSION
    ) {
        if (is_file($file)) {
            unlink($file);
        }

        refuse('SESSION_EXPIRED');
    }

    $s['role'] = $role;
    $s['seen'] = $now;

    file_put_contents(
        $file,
        json_encode($s)
    );

    foreach (
        glob(
            AUTH_DIR . '/sessions/*'
        ) ?: []
        as $old
    ) {
        if (
            $now -
            filemtime($old) >
            MAX_SESSION
        ) {
            @unlink($old);
        }
    }

    return (string) $s['user'];
}

// ---------------------------------------------------------------------------------------------
// Reading the server

function quota_mount(): string {
    [, $out] = run([
        'df',
        '--output=target',
        STUDENT_ROOT
    ]);

    $lines = array_values(
        array_filter(
            explode(
                "\n",
                trim($out)
            )
        )
    );

    return end($lines) ?: '/';
}

function quotas_on(): bool {
    [, $out] = run([
        'quotaon',
        '-pu',
        quota_mount()
    ]);

    return str_contains(
        $out,
        ' is on'
    );
}

/** username => [used_kb, limit_kb], from one repquota call. */
function quota_map(): array {
    [
        $code,
        $out
    ] = run([
        'repquota',
        '-u',
        '-O',
        'csv',
        quota_mount()
    ]);

    if ($code !== 0) {
        return [];
    }

    $lines = array_values(
        array_filter(
            explode(
                "\n",
                trim($out)
            )
        )
    );

    $head = str_getcsv(
        array_shift($lines) ?? ''
    );

    $used = $hard = null;

    foreach ($head as $i => $h) {
        if (
            $used === null &&
            str_ends_with(
                $h,
                'Used'
            ) &&
            !str_starts_with(
                $h,
                'File'
            )
        ) {
            $used = $i;
        }

        if (
            $hard === null &&
            str_ends_with(
                $h,
                'HardLimit'
            ) &&
            !str_starts_with(
                $h,
                'File'
            )
        ) {
            $hard = $i;
        }
    }

    $map = [];

    foreach ($lines as $line) {
        $row = str_getcsv($line);

        if (
            $used !== null &&
            $hard !== null &&
            isset($row[$hard])
        ) {
            $map[$row[0]] = [
                (int) $row[$used],
                (int) $row[$hard]
            ];
        }
    }

    return $map;
}

function mysql_datadir(): string {
    [
        ,
        $out
    ] = run([
        'mysql',
        '-N',
        '-B',
        '-e',
        'SELECT @@datadir'
    ]);

    return rtrim(
        trim($out),
        '/'
    );
}

/** username => MB, from one du call over every student database folder. */
function db_sizes(array $users): array {
    $dir = mysql_datadir();

    $paths = array_values(
        array_filter(
            array_map(
                fn($u) => "{$dir}/{$u}",
                $users
            ),
            'is_dir'
        )
    );

    if (
        $dir === '' ||
        !$paths
    ) {
        return [];
    }

    [
        ,
        $out
    ] = run(
        array_merge(
            ['du', '-sk'],
            $paths
        )
    );

    $map = [];

    foreach (
        explode(
            "\n",
            trim($out)
        ) as $line
    ) {
        [
            $kb,
            $path
        ] = array_pad(
            preg_split(
                '/\s+/',
                $line,
                2
            ),
            2,
            ''
        );

        $map[
            basename($path)
        ] = round(
            ((int) $kb) / 1024,
            1
        );
    }

    return $map;
}

function last_logins(): array {
    [
        ,
        $out
    ] = run(['lastlog']);

    $map = [];

    foreach (
        array_slice(
            explode("\n", $out),
            1
        ) as $line
    ) {
        $name = strtok(
            $line,
            ' '
        );

        if (
            $name &&
            !str_contains(
                $line,
                'Never logged in'
            ) &&
            preg_match(
                '/(\w{3} \w{3} +\d+ [\d:]+ [+-]\d{4} \d{4})\s*$/',
                $line,
                $m
            )
        ) {
            $map[$name] =
                strtotime($m[1]) ?: null;
        }
    }

    return $map;
}

function online_users(): array {
    [
        ,
        $out
    ] = run(['who']);

    $names = [];

    foreach (
        explode(
            "\n",
            trim($out)
        ) as $line
    ) {
        if ($line !== '') {
            $names[
                strtok(
                    $line,
                    ' '
                )
            ] = true;
        }
    }

    return $names;
}


/** True for server accounts allowed to administer the machine outside the panel. */
function privileged_user(string $user): bool {
    static $cache = [
        'root' => true
    ];

    if (array_key_exists($user, $cache)) {
        return $cache[$user];
    }

    if (!preg_match('/^[a-z_][a-z0-9_.-]{0,31}$/', $user)) {
        return $cache[$user] = false;
    }

    $pw = posix_getpwnam($user);

    if ($pw === false || (int) $pw['uid'] < 1000) {
        return $cache[$user] = false;
    }

    [, $groups] = run([
        'id',
        '-nG',
        $user
    ]);

    $groups = preg_split(
        '/\s+/',
        trim($groups),
        -1,
        PREG_SPLIT_NO_EMPTY
    );

    return $cache[$user] = (bool) array_intersect(
        [
            'sudo',
            'admin'
        ],
        $groups
    );
}

/** Pulls the timestamp and daemon message out of rsyslog or journalctl output. */
function auth_log_parts(string $line): ?array {
    if (preg_match(
        '/^([A-Z][a-z]{2}\s+\d{1,2}\s+\d{2}:\d{2}:\d{2})\s+\S+\s+(.*)$/',
        $line,
        $m
    )) {
        $year = (int) date('Y');
        $time = strtotime($m[1] . ' ' . $year);

        if ($time !== false && $time > time() + 86400) {
            $time = strtotime($m[1] . ' ' . ($year - 1));
        }

        return $time === false
            ? null
            : ['time' => $time, 'message' => $m[2]];
    }

    if (preg_match(
        '/^(\d{4}-\d{2}-\d{2}T[^\s]+)\s+\S+\s+(.*)$/',
        $line,
        $m
    )) {
        $time = strtotime($m[1]);

        return $time === false
            ? null
            : ['time' => $time, 'message' => $m[2]];
    }

    return null;
}

/** Removes sshd/sudo's syslog prefix while leaving the event text intact. */
function auth_daemon_message(string $message): string {
    return preg_replace(
        '/^(?:sshd|ssh|sudo)(?:\[\d+\])?:\s*/',
        '',
        $message
    ) ?? $message;
}

/** Redacts common password arguments before a sudo command is displayed in the panel. */
function redact_privileged_command(string $command): string {
    $command = preg_replace(
        '/(--password=)\S+/i',
        '$1[REDACTED]',
        $command
    ) ?? $command;

    $command = preg_replace(
        '/(--password\s+)\S+/i',
        '$1[REDACTED]',
        $command
    ) ?? $command;

    $command = preg_replace(
        '/(^|\s)-p(\S*)/',
        '$1-p[REDACTED]',
        $command
    ) ?? $command;

    $command = preg_replace(
        '/(^|\s)-p\s+\S+/',
        '$1-p [REDACTED]',
        $command
    ) ?? $command;

    return $command;
}

/**
 * Reads the OS authentication log and turns only privileged-account SSH/sudo activity into
 * the same "[time] [address] user: action" format used by the other admin log tabs.
 *
 * Student accounts are excluded by privileged_user(). Normal shell commands are not available
 * from sshd/auth.log; commands recorded by sudo are shown because those are explicit privilege
 * escalations.
 */
function privileged_log(
    int $lines,
    array $filters
): array {
    $want = max(
        10,
        min($lines, 2000)
    );

    $raw = '';

    foreach (
        [
            '/var/log/auth.log',
            '/var/log/secure'
        ] as $candidate
    ) {
        if (!is_readable($candidate)) {
            continue;
        }

        [
            $code,
            $out
        ] = run([
            'tail',
            '-n',
            (string) min($want * 8, 10000),
            $candidate
        ]);

        if ($code === 0 && trim($out) !== '') {
            $raw = $out;
            break;
        }
    }

    if ($raw === '') {
        [
            $code,
            $out
        ] = run([
            'journalctl',
            '--no-pager',
            '--output=short-iso',
            '-n',
            (string) min($want * 8, 10000)
        ]);

        if ($code === 0) {
            $raw = $out;
        }
    }

    if ($raw === '') {
        return [];
    }

    $events = [];

    foreach (explode("\n", $raw) as $line) {
        $part = auth_log_parts($line);

        if ($part === null) {
            continue;
        }

        $message = auth_daemon_message($part['message']);

        if (preg_match(
            '/^Accepted\s+(\S+)\s+for\s+([a-zA-Z0-9_.-]+)\s+from\s+([0-9a-fA-F:.]+)\b/',
            $message,
            $m
        ) && privileged_user($m[2])) {
            $events[] = [
                'time' => $part['time'],
                'line' => sprintf(
                    '[%s] [%s] %s: SSH login accepted via %s',
                    date(DATE_ATOM, $part['time']),
                    $m[3],
                    $m[2],
                    $m[1]
                )
            ];
            continue;
        }

        if (preg_match(
            '/^Failed\s+(\S+)\s+for\s+(?:invalid user\s+)?([a-zA-Z0-9_.-]+)\s+from\s+([0-9a-fA-F:.]+)\b/',
            $message,
            $m
        ) && privileged_user($m[2])) {
            $events[] = [
                'time' => $part['time'],
                'line' => sprintf(
                    '[%s] [%s] %s: FAILED SSH login via %s',
                    date(DATE_ATOM, $part['time']),
                    $m[3],
                    $m[2],
                    $m[1]
                )
            ];
            continue;
        }

        if (preg_match(
            '/^([a-zA-Z0-9_.-]+)\s*:\s*TTY=.*?;\s*PWD=.*?;\s*USER=([a-zA-Z0-9_.-]+)\s*;\s*COMMAND=(.+)$/',
            $message,
            $m
        ) && privileged_user($m[1])) {
            $command = redact_privileged_command($m[3]);

            $events[] = [
                'time' => $part['time'],
                'line' => sprintf(
                    '[%s] %s: sudo as %s: %s (source IP is not recorded by sudo)',
                    date(DATE_ATOM, $part['time']),
                    $m[1],
                    $m[2],
                    $command
                )
            ];
            continue;
        }
    }

    if (array_filter($filters, fn(string $v): bool => $v !== '')) {
        $events = array_values(array_filter(
            $events,
            fn(array $event): bool =>
                log_line_matches_filters($event['line'], $filters)
        ));
    }

    usort(
        $events,
        fn(array $a, array $b): int =>
            $b['time'] <=> $a['time']
    );

    $events = array_slice($events, 0, $want);

    return array_map(
        fn(array $event): string => $event['line'],
        $events
    );
}

function registry_records(): array {
    $map = [];

    foreach (
        glob(
            REGISTRY_DIR . '/*'
        ) ?: [] as $file
    ) {
        $r = json_decode(
            (string) @file_get_contents($file),
            true
        );

        if (
            is_array($r) &&
            isset($r['username'])
        ) {
            $map[$r['username']] = $r;
        }
    }

    return $map;
}

function student_names(): array {
    $users = [];

    [
        ,
        $out
    ] = run(['getent', 'passwd']);

    foreach (
        explode(
            "\n",
            trim($out)
        ) as $line
    ) {
        $f = explode(
            ':',
            $line
        );

        if (
            count($f) >= 7 &&
            str_starts_with(
                $f[5],
                STUDENT_ROOT . '/'
            ) &&
            preg_match(
                USERNAME_RE,
                $f[0]
            )
        ) {
            $users[$f[0]] = [
                'uid' => (int) $f[2],
                'full_name' => explode(
                    ',',
                    $f[4]
                )[0]
            ];
        }
    }

    ksort($users);

    return $users;
}

/** The name given when the account was made, or else one read from the email. */
function display_name(
    string $gecos,
    ?string $email
): string {
    if (
        $gecos !== '' &&
        $gecos !== '5CS045 student'
    ) {
        return $gecos;
    }

    if ($email === null) {
        return '';
    }

    $local = preg_replace(
        '/[^a-z]+/',
        ' ',
        strtolower(
            strstr(
                $email,
                '@',
                true
            ) ?: ''
        )
    );

    return ucwords(
        trim((string) $local)
    );
}

function students_list(): array {
    $users = student_names();
    $names = array_keys($users);
    $quota = quota_map();
    $db = db_sizes($names);
    $last = last_logins();
    $online = online_users();
    $reg = registry_records();

    $rows = [];

    foreach (
        $users as $name => $u
    ) {
        $home =
            STUDENT_ROOT .
            '/' .
            $name;

        $rows[] = [
            'username' => $name,
            'full_name' => display_name(
                $u['full_name'],
                $reg[$name]['email'] ?? null
            ),
            'email' =>
                $reg[$name]['email'] ?? null,
            'registered_at' =>
                $reg[$name]['registered_at'] ??
                (
                    ($t = @filectime($home))
                        ? date(DATE_ATOM, $t)
                        : null
                ),
            'disk_used_mb' =>
                isset($quota[$name])
                    ? round(
                        $quota[$name][0] / 1024,
                        1
                    )
                    : null,
            'disk_limit_mb' =>
                isset($quota[$name]) &&
                $quota[$name][1] > 0
                    ? (int) round(
                        $quota[$name][1] / 1024
                    )
                    : null,
            'db_mb' =>
                $db[$name] ?? 0.0,
            'db_locked' =>
                is_file(
                    DB_OVER_DIR . '/' . $name
                ),
            'last_login' =>
                isset($last[$name])
                    ? date(
                        DATE_ATOM,
                        $last[$name]
                    )
                    : null,
            'online' =>
                isset($online[$name]),
        ];
    }

    return $rows;
}

function meminfo(): array {
    $m = [];

    foreach (
        file('/proc/meminfo') ?: []
        as $line
    ) {
        if (
            preg_match(
                '/^(\w+):\s+(\d+)/',
                $line,
                $x
            )
        ) {
            $m[$x[1]] =
                (int) $x[2];
        }
    }

    return $m;
}

function health(): array {
    $df = disk_total_space('/') ?: 0;
    $free = disk_free_space('/') ?: 0;
    $m = meminfo();

    $services = [];

    foreach (
        SERVICES as $svc
    ) {
        [
            ,
            $state
        ] = run([
            'timeout',
            '5',
            'systemctl',
            'is-active',
            $svc
        ]);

        $services[$svc] =
            trim($state) ?: 'unknown';
    }

    [
        $lcode,
        $lout
    ] = run([
        'timeout',
        '5',
        'loginctl',
        'list-sessions',
        '--no-legend'
    ]);

    $load = explode(
        ' ',
        (string) @file_get_contents(
            '/proc/loadavg'
        )
    );

    [
        ,
        $cores
    ] = run(['nproc']);

    $c = smtp();

    $h = [
        'disk' => [
            'total' => $df,
            'used' => $df - $free,
            'percent' =>
                $df
                    ? round(
                        100 *
                        ($df - $free) /
                        $df
                    )
                    : 0
        ],
        'memory' => [
            'total' =>
                ($m['MemTotal'] ?? 0) * 1024,
            'available' =>
                ($m['MemAvailable'] ?? 0) * 1024,
            'percent' =>
                ($m['MemTotal'] ?? 0)
                    ? round(
                        100 *
                        (
                            1 -
                            (
                                ($m['MemAvailable'] ?? 0) /
                                $m['MemTotal']
                            )
                        )
                    )
                    : 0
        ],
        'swap' => [
            'total' =>
                ($m['SwapTotal'] ?? 0) * 1024,
            'used' =>
                (
                    ($m['SwapTotal'] ?? 0) -
                    ($m['SwapFree'] ?? 0)
                ) * 1024
        ],
        'load' =>
            (float) ($load[0] ?? 0),
        'cores' =>
            (int) trim($cores) ?: 1,
        'uptime' =>
            (int) (
                floatval(
                    explode(
                        ' ',
                        (string) @file_get_contents(
                            '/proc/uptime'
                        )
                    )[0]
                )
            ),
        'services' => $services,
        'logind_ok' =>
            $lcode === 0,
        'sessions' =>
            $lcode === 0
                ? count(
                    array_filter(
                        explode(
                            "\n",
                            trim($lout)
                        )
                    )
                )
                : null,
        'quotas_on' => quotas_on(),
        'admin_email' =>
            (string) (
                $c['admin_email'] ?? ''
            ),
        'server_url' => site_url(),
        'students' =>
            count(student_names()),
        'online' =>
            count(
                array_intersect_key(
                    online_users(),
                    student_names()
                )
            ),
    ];

    $alerts = [];

    if (
        $h['disk']['percent'] >= 80
    ) {
        $alerts[] = [
            'danger',
            "The disk is {$h['disk']['percent']}% full."
        ];
    }

    if (
        $h['memory']['percent'] >= 90
    ) {
        $alerts[] = [
            'danger',
            "Memory is {$h['memory']['percent']}% used."
        ];
    }

    foreach (
        $services as $svc => $state
    ) {
        if ($state !== 'active') {
            $alerts[] = [
                'danger',
                "{$svc} is {$state}."
            ];
        }
    }

    if (!$h['logind_ok']) {
        $alerts[] = [
            'danger',
            'The login service is not answering, so SSH logins may fail. It restarts itself within 2 minutes; if not, reboot.'
        ];
    }

    if (!$h['quotas_on']) {
        $alerts[] = [
            'warning',
            'Disk quotas are off, so students have no disk limit.'
        ];
    }

    if ($h['admin_email'] === '') {
        $alerts[] = [
            'warning',
            'No admin_email is set, so disk and login alerts are not emailed.'
        ];
    }

    $h['alerts'] = $alerts;

    return $h;
}

function bans(): array {
    $out = [];

    foreach (
        ['sshd', 'recidive'] as $jail
    ) {
        [
            $code,
            $status
        ] = run([
            'fail2ban-client',
            'status',
            $jail
        ]);

        $list = preg_match(
            '/Banned IP list:\s*(.*)$/m',
            $status,
            $m
        )
            ? preg_split(
                '/\s+/',
                trim($m[1]),
                -1,
                PREG_SPLIT_NO_EMPTY
            )
            : [];

        $out[] = [
            'jail' => $jail,
            'running' => $code === 0,
            'banned' => $list
        ];
    }

    return $out;
}


function log_line_fields(string $line): array {
    $time = '';
    $ip = '';
    $user = '';
    $event = trim($line);

    if (preg_match(
        '/^\\[([^\\]]+)\\]\\s*(?:\\[([^\\]]+)\\]\\s*)?([^:]+):\\s*(.*)$/',
        $line,
        $m
    )) {
        $time = trim($m[1]);
        $ip = trim((string) ($m[2] ?? ''));
        $user = trim($m[3]);
        $event = trim($m[4]);
    }

    return [
        'time' => $time,
        'user' => $user,
        'event' => $event,
        'ip' => $ip
    ];
}

function log_line_matches_filters(string $line, array $filters): bool {
    $fields = log_line_fields($line);

    foreach ($filters as $key => $needle) {
        $needle = trim($needle);

        if ($needle === '') {
            continue;
        }

        $value = $fields[$key] ?? '';

        if (stripos($value, $needle) === false) {
            return false;
        }
    }

    return true;
}

function tail_log(
    string $which,
    int $lines,
    array $filters
): array {
    if ($which === 'privileged') {
        return privileged_log(
            $lines,
            $filters
        );
    }

    $file =
        LOGS[$which] ??
        refuse('Unknown log.');

    [
        ,
        $out
    ] = run([
        'tail',
        '-n',
        (string) max(
            10,
            min($lines * 8, 10000)
        ),
        $file
    ]);

    $rows = array_values(
        array_filter(
            explode(
                "\n",
                $out
            ),
            fn($l) =>
                $l !== '' &&
                log_line_matches_filters(
                    $l,
                    $filters
                )
        )
    );

    return array_slice(
        array_reverse($rows),
        0,
        max(10, min($lines, 2000))
    );
}
// ---------------------------------------------------------------------------------------------
// Allowlist of addresses that may open the panel

function valid_address(string $a): bool {
    if (str_contains($a, '/')) {
        [
            $ip,
            $bits
        ] = explode(
            '/',
            $a,
            2
        );

        $max =
            str_contains($ip, ':')
                ? 128
                : 32;

        return (
            filter_var(
                $ip,
                FILTER_VALIDATE_IP
            ) !== false &&
            ctype_digit($bits) &&
            (int) $bits >= 8 &&
            (int) $bits <= $max
        );
    }

    return filter_var(
        $a,
        FILTER_VALIDATE_IP
    ) !== false;
}

function allowlist(): array {
    $list = [];

    foreach (
        @file(
            ALLOW_FILE,
            FILE_IGNORE_NEW_LINES
        ) ?: [] as $line
    ) {
        if (
            preg_match(
                '/^\s*allow\s+([^;\s]+)\s*;/',
                $line,
                $m
            ) &&
            !in_array(
                $m[1],
                ['127.0.0.1', '::1'],
                true
            )
        ) {
            $list[] = $m[1];
        }
    }

    return $list;
}

function ip_in(
    string $ip,
    string $entry
): bool {
    if (!str_contains($entry, '/')) {
        return inet_pton($ip) === inet_pton($entry);
    }

    [
        $net,
        $bits
    ] = explode(
        '/',
        $entry,
        2
    );

    $a = inet_pton($ip);
    $b = inet_pton($net);

    if (
        $a === false ||
        $b === false ||
        strlen($a) !== strlen($b)
    ) {
        return false;
    }

    $bits = (int) $bits;
    $bytes = intdiv($bits, 8);

    if (
        substr(
            $a,
            0,
            $bytes
        ) !== substr(
            $b,
            0,
            $bytes
        )
    ) {
        return false;
    }

    $rem = $bits % 8;

    return (
        $rem === 0 ||
        (
            (
                ord($a[$bytes]) ^
                ord($b[$bytes])
            ) &
            (0xFF << (8 - $rem)) &
            0xFF
        ) === 0
    );
}

function write_allowlist(
    array $entries,
    string $ip
): void {
    $entries = array_values(
        array_unique(
            array_filter(
                array_map(
                    'trim',
                    $entries
                )
            )
        )
    );

    foreach ($entries as $e) {
        if (!valid_address($e)) {
            refuse(
                "\"{$e}\" is not an IP address or range (like 10.21.4.57 or 10.21.4.0/24)."
            );
        }
    }

    $covered =
        in_array(
            $ip,
            ['127.0.0.1', '::1'],
            true
        );

    foreach ($entries as $e) {
        $covered =
            $covered ||
            ip_in($ip, $e);
    }

    if (!$covered) {
        refuse(
            "That would lock you out: your address {$ip} must stay on the list."
        );
    }

    $body =
        "# Addresses allowed to open the admin panel. Written by the panel (Security page)\n" .
        "# or bin/admin-allow.sh. The server itself is always allowed.\n" .
        "allow 127.0.0.1;\n" .
        "allow ::1;\n";

    foreach ($entries as $e) {
        $body .=
            "allow {$e};\n";
    }

    $body .= "deny all;\n";

    $old = @file_get_contents(
        ALLOW_FILE
    );

    file_put_contents(
        ALLOW_FILE,
        $body,
        LOCK_EX
    );

    [
        $code,
        ,
        $err
    ] = run([
        'nginx',
        '-t'
    ]);

    if ($code !== 0) {
        if ($old !== false) {
            file_put_contents(
                ALLOW_FILE,
                $old
            );
        }

        refuse(
            'nginx rejected the list, nothing was changed: ' .
            trim($err)
        );
    }

    run([
        'systemctl',
        'reload',
        'nginx'
    ]);
}

// ---------------------------------------------------------------------------------------------
// Background jobs

function start_job(
    string $kind,
    array $params,
    string $admin,
    string $ip
): string {
    @mkdir(
        JOB_DIR,
        0700,
        true
    );

    $id =
        date('Ymd-His') .
        '-' .
        bin2hex(
            random_bytes(3)
        );

    mkdir(
        JOB_DIR . "/{$id}",
        0700
    );

    file_put_contents(
        JOB_DIR . "/{$id}/meta.json",
        json_encode([
            'kind' => $kind,
            'params' => $params,
            'admin' => $admin,
            'ip' => $ip,
            'started' => time()
        ])
    );

    $self =
        DEPLOY_ROOT .
        '/bin/admin-action';

    if (is_dir('/run/systemd/system')) {
        run([
            'systemd-run',
            '--quiet',
            '--collect',
            "--unit=5cs045-job-{$id}",
            $self,
            '--job',
            $id
        ]);
    } else {
        exec(
            'setsid ' .
            escapeshellarg($self) .
            ' --job ' .
            escapeshellarg($id) .
            ' >/dev/null 2>&1 &'
        );
    }

    $all =
        glob(
            JOB_DIR . '/*',
            GLOB_ONLYDIR
        ) ?: [];

    rsort($all);

    foreach (
        array_slice($all, 30)
        as $old
    ) {
        array_map(
            'unlink',
            glob(
                "{$old}/*"
            ) ?: []
        );

        @rmdir($old);
    }

    return $id;
}

function job_status(string $id): array {
    if (
        !preg_match(
            '/^\d{8}-\d{6}-[a-f0-9]{6}$/',
            $id
        ) ||
        !is_dir(
            JOB_DIR . "/{$id}"
        )
    ) {
        refuse('No such job.');
    }

    $meta =
        json_decode(
            (string) file_get_contents(
                JOB_DIR . "/{$id}/meta.json"
            ),
            true
        ) ?: [];

    $exit =
        @file_get_contents(
            JOB_DIR . "/{$id}/exit"
        );

    [
        ,
        $log
    ] = run([
        'tail',
        '-n',
        '400',
        JOB_DIR . "/{$id}/log"
    ]);

    unset(
        $meta['params']['emails']
    );

    return $meta + [
        'id' => $id,
        'done' => $exit !== false,
        'exit' =>
            $exit === false
                ? null
                : (int) $exit,
        'log' => $log
    ];
}

function run_job(string $id): void {
    if (
        !preg_match(
            '/^\d{8}-\d{6}-[a-f0-9]{6}$/',
            $id
        )
    ) {
        exit(1);
    }

    $dir =
        JOB_DIR . "/{$id}";

    $meta =
        json_decode(
            (string) file_get_contents(
                "{$dir}/meta.json"
            ),
            true
        );

    $log =
        fopen(
            "{$dir}/log",
            'a'
        );

    $say =
        function (string $s) use ($log) {
            fwrite(
                $log,
                $s . "\n"
            );

            fflush($log);
        };

    $stream =
        function (array $cmd) use ($log): int {
            $proc = proc_open(
                $cmd,
                [
                    0 => [
                        'file',
                        '/dev/null',
                        'r'
                    ],
                    1 => $log,
                    2 => $log
                ],
                $pipes
            );

            return is_resource($proc)
                ? proc_close($proc)
                : 127;
        };

    $code = 1;

    switch (
        $meta['kind'] ?? ''
    ) {
        case 'smoke-test':
            $code =
                $stream([
                    DEPLOY_ROOT .
                    '/test/smoke-test.sh'
                ]);
            break;

        case 'remove-all':
            $code =
                $stream([
                    DEPLOY_ROOT .
                    '/bin/remove-all-students.sh',
                    '--yes'
                ]);
            break;

        case 'bulk-add':
            $code =
                bulk_add(
                    $meta['params'],
                    $say
                );
            break;
    }

    audit(
        (string) (
            $meta['admin'] ?? '?'
        ),
        (string) (
            $meta['ip'] ?? '?'
        ),
        "job {$id} ({$meta['kind']}) finished with exit {$code}"
    );

    file_put_contents(
        "{$dir}/exit",
        (string) $code
    );
}

function bulk_add(
    array $p,
    callable $say
): int {
    require_once WEB_LIB . '/credentials.php';

    $emails = array_values(
        array_unique(
            array_filter(
                array_map(
                    fn($e) => strtolower(
                        trim($e)
                    ),
                    preg_split(
                        '/[\s,;]+/',
                        (string) (
                            $p['emails'] ?? ''
                        )
                    )
                )
            )
        )
    );

    $send =
        !empty(
            $p['send_email']
        );

    $domain =
        (string) (
            smtp()['allowed_email_domain'] ?? ''
        );

    $made =
        $skipped =
        $failed = 0;

    $say(
        count($emails) .
        ' email address(es) to process.' .
        (
            $send
                ? ' Each new student is emailed their login.'
                : ''
        )
    );

    foreach ($emails as $email) {
        $user =
            valid_email($email)
                ? derive_username($email)
                : null;

        if ($user === null) {
            $say(
                "SKIPPED {$email}: not a usable email address"
            );

            $skipped++;
            continue;
        }

        if (
            $domain !== '' &&
            strcasecmp(
                substr(
                    $email,
                    strrpos($email, '@') + 1
                ),
                $domain
            ) !== 0
        ) {
            $say(
                "SKIPPED {$email}: not an @{$domain} address"
            );

            $skipped++;
            continue;
        }

        if (
            posix_getpwnam($user) !== false
        ) {
            $say(
                "SKIPPED {$email}: {$user} already exists"
            );

            $skipped++;
            continue;
        }

        [
            $code,
            $out,
            $err
        ] = run([
            DEPLOY_ROOT .
            '/bin/add-student.sh',
            '-u',
            $user,
            '-e',
            $email,
            '-R'
        ]);

        if ($code !== 0) {
            $say(
                "FAILED {$email}: " .
                trim($err ?: $out)
            );

            $failed++;
            continue;
        }

        remember_email(
            $user,
            $email
        );

        $made++;

        $mailError =
            $send
                ? send_credentials(
                    $user,
                    $email
                )
                : null;

        $say(
            "ADDED {$user} ({$email})" .
            (
                $send
                    ? (
                        $mailError
                            ? " - email FAILED: {$mailError}"
                            : ' - emailed'
                    )
                    : ''
            )
        );
    }

    $say(
        'Reloading PHP and systemd once for the new accounts...'
    );

    run([
        'systemctl',
        'daemon-reload'
    ]);

    run([
        'systemctl',
        'reload',
        'php8.3-fpm'
    ]);

    $say(
        "Done: {$made} added, {$skipped} skipped, {$failed} failed."
    );

    return $failed > 0
        ? 1
        : 0;
}

// ---------------------------------------------------------------------------------------------
// Entry point

if (posix_geteuid() !== 0) {
    refuse(
        'admin-action must run as root.'
    );
}

umask(0077);

if (
    ($argv[1] ?? '') === '--job'
) {
    run_job(
        $argv[2] ?? ''
    );

    exit(0);
}

$req =
    json_decode(
        (string) stream_get_contents(STDIN),
        true
    );

if (!is_array($req)) {
    refuse('Bad request.');
}

$action =
    (string) (
        $req['action'] ?? ''
    );

$ip =
    (string) (
        $req['ip'] ?? ''
    );

$args =
    is_array(
        $req['args'] ?? null
    )
        ? $req['args']
        : [];

if (
    filter_var(
        $ip,
        FILTER_VALIDATE_IP
    ) === false
) {
    refuse('Bad request.');
}

if ($action === 'login') {
    do_login(
        $args,
        $ip
    );
}

$admin =
    check_token(
        (string) (
            $req['token'] ?? ''
        ),
        $ip
    );

switch ($action) {
    case 'panel-accounts':
        if ($admin !== 'fullstack') {
            refuse('SUPERADMIN_REQUIRED');
        }
        reply(panel_accounts());

    case 'create-panel-account':
        if ($admin !== 'fullstack') {
            refuse('SUPERADMIN_REQUIRED');
        }
        reply(create_panel_account($args, $admin, $ip));

    case 'delete-panel-account':
        if ($admin !== 'fullstack') {
            refuse('SUPERADMIN_REQUIRED');
        }
        delete_panel_account(arg($args, 'username'), $admin, $ip);
        reply(true);

    case 'admin-users':
        if ($admin !== 'fullstack') {
            refuse('SUPERADMIN_REQUIRED');
        }
        reply(admin_users());

    case 'admin-grant':
        if ($admin !== 'fullstack') {
            refuse('SUPERADMIN_REQUIRED');
        }

        $target = arg($args, 'username');
        if ($target === 'fullstack') {
            refuse('The fullstack account is already the superadmin.');
        }
        if (!panel_account_exists($target)) {
            refuse('That is not an existing non-student server account.');
        }

        $users = admin_users();
        if (!in_array($target, $users, true)) {
            $users[] = $target;
            write_admin_users($users);
            audit($admin, $ip, "granted admin role to {$target}");
        }
        reply(admin_users());

    case 'admin-revoke':
        if ($admin !== 'fullstack') {
            refuse('SUPERADMIN_REQUIRED');
        }

        $target = arg($args, 'username');
        if ($target === 'fullstack') {
            refuse('The fullstack account is always the superadmin.');
        }

        $users = array_values(array_filter(
            admin_users(),
            fn(string $user): bool => $user !== $target
        ));
        write_admin_users($users);
        invalidate_user_sessions($target);
        audit($admin, $ip, "revoked admin role from {$target}");
        reply(admin_users());

    case 'logout':
        @unlink(
            AUTH_DIR .
            '/sessions/' .
            hash(
                'sha256',
                (string) $req['token']
            )
        );

        audit(
            $admin,
            $ip,
            'signed out'
        );

        reply(true);

    case 'ping':
        reply([
            'user' => $admin,
            'role' => admin_role($admin)
        ]);

    case 'health':
        reply(
            health()
        );

    case 'students':
        reply(
            students_list()
        );

    case 'student':
        $user =
            student_or_refuse(
                arg(
                    $args,
                    'username'
                )
            );

        foreach (
            students_list()
            as $row
        ) {
            if (
                $row['username'] === $user
            ) {
                $row['quota_override'] =
                    is_file(
                        QUOTA_OVERRIDE_DIR .
                        "/{$user}"
                    );

                $row['has_saved_password'] =
                    saved_password($user) !== null;

                $row['db_limit_mb'] =
                    DB_LIMIT_MB;

                $row['default_quota_mb'] =
                    DEFAULT_QUOTA_MB;

                $row['server_url'] =
                    site_url();

                $row['folder_access'] =
                    student_folder_access($user);

                reply($row);
            }
        }

        refuse(
            "There is no student called {$user}."
        );

    case 'add-student':
        require_once WEB_LIB . '/credentials.php';

        $email =
            strtolower(
                arg(
                    $args,
                    'email'
                )
            );

        $name =
            preg_replace(
                '/[^\p{L}\p{N} .\'-]/u',
                '',
                arg(
                    $args,
                    'full_name'
                )
            );

        if (
            $email !== '' &&
            !valid_email($email)
        ) {
            refuse(
                'That email address does not look right.'
            );
        }

        $user =
            arg(
                $args,
                'username'
            ) ?:
            (
                $email !== ''
                    ? (string) derive_username($email)
                    : ''
            );

        if (!preg_match(
            USERNAME_RE,
            $user
        )) {
            refuse(
                'Give a username (3-32 lowercase letters, numbers or _ , starting with a letter) or an email to make one from.'
            );
        }

        if (
            posix_getpwnam($user) !== false
        ) {
            refuse(
                "{$user} already exists."
            );
        }

        $cmd = [
            DEPLOY_ROOT .
            '/bin/add-student.sh',
            '-u',
            $user,
            '-d'
        ];

        if ($name !== '') {
            array_push(
                $cmd,
                '-n',
                $name
            );
        }

        if ($email !== '') {
            array_push(
                $cmd,
                '-e',
                $email
            );
        }

        [
            $code,
            $out,
            $err
        ] = run($cmd);

        if ($code !== 0) {
            refuse(
                'Could not create the account: ' .
                trim($err ?: $out)
            );
        }

        if ($email !== '') {
            remember_email(
                $user,
                $email
            );
        }

        $mailError =
            (
                $email !== '' &&
                !empty(
                    $args['send_email']
                )
            )
                ? send_credentials(
                    $user,
                    $email
                )
                : null;

        audit(
            $admin,
            $ip,
            "added student {$user}" .
            (
                $email !== ''
                    ? " ({$email})"
                    : ''
            )
        );

        reply([
            'username' =>
                $user,
            'password' =>
                saved_password($user),
            'emailed' =>
                $email !== '' &&
                !empty(
                    $args['send_email']
                ) &&
                $mailError === null,
            'email' =>
                $email ?: null,
            'email_error' =>
                $mailError
        ]);

    case 'reset-password':
        $user =
            student_or_refuse(
                arg(
                    $args,
                    'username'
                )
            );

        [
            $code,
            $out,
            $err
        ] = run([
            DEPLOY_ROOT .
            '/bin/reset-student-password.sh',
            '-u',
            $user
        ]);

        if ($code !== 0) {
            refuse(
                'Could not reset the password: ' .
                trim($err ?: $out)
            );
        }

        $email =
            strtolower(
                arg(
                    $args,
                    'email'
                )
            );

        $mailError = null;

        if ($email !== '') {
            if (!valid_email($email)) {
                refuse(
                    'The password was changed, but that email address does not look right.'
                );
            }

            remember_email(
                $user,
                $email
            );

            $mailError =
                send_credentials(
                    $user,
                    $email
                );
        }

        audit(
            $admin,
            $ip,
            "reset the password of {$user}" .
            (
                $email !== ''
                    ? " and emailed {$email}"
                    : ''
            )
        );

        reply([
            'username' =>
                $user,
            'password' =>
                saved_password($user),
            'emailed' =>
                $email !== '' &&
                $mailError === null,
            'email_error' =>
                $mailError
        ]);

    case 'resend':
        $user =
            student_or_refuse(
                arg(
                    $args,
                    'username'
                )
            );

        $email =
            strtolower(
                arg(
                    $args,
                    'email'
                )
            );

        if (!valid_email($email)) {
            refuse(
                'That email address does not look right.'
            );
        }

        $mailError =
            send_credentials(
                $user,
                $email
            );

        if ($mailError !== null) {
            refuse(
                "The email could not be sent: {$mailError}"
            );
        }

        remember_email(
            $user,
            $email
        );

        audit(
            $admin,
            $ip,
            "emailed the login of {$user} to {$email}"
        );

        reply([
            'emailed' => $email
        ]);

    case 'show-password':
        $user =
            student_or_refuse(
                arg(
                    $args,
                    'username'
                )
            );

        audit(
            $admin,
            $ip,
            "viewed the saved password of {$user}"
        );

        reply([
            'password' =>
                saved_password($user)
        ]);

    case 'set-quota':
        $user =
            student_or_refuse(
                arg(
                    $args,
                    'username'
                )
            );

        $mb =
            (int) arg(
                $args,
                'mb'
            );

        if (
            $mb < 50 ||
            $mb > 20480
        ) {
            refuse(
                'Choose a disk limit between 50 MB and 20 GB.'
            );
        }

        @mkdir(
            QUOTA_OVERRIDE_DIR,
            0700,
            true
        );

        if (
            $mb === DEFAULT_QUOTA_MB
        ) {
            @unlink(
                QUOTA_OVERRIDE_DIR .
                "/{$user}"
            );
        } else {
            file_put_contents(
                QUOTA_OVERRIDE_DIR .
                "/{$user}",
                (string) (
                    $mb * 1024
                )
            );
        }

        [
            $code,
            $out,
            $err
        ] = run([
            DEPLOY_ROOT .
            '/bin/apply-student-limits.sh',
            '--no-reload',
            $user
        ]);

        if ($code !== 0) {
            refuse(
                'Could not set the limit: ' .
                trim($err ?: $out)
            );
        }

        audit(
            $admin,
            $ip,
            "set the disk limit of {$user} to {$mb} MB"
        );

        reply([
            'username' =>
                $user,
            'mb' =>
                $mb,
            'warning' =>
                quotas_on()
                    ? null
                    : 'Disk quotas are off on this server, so the limit is saved but not enforced yet.'
        ]);

    case 'set-folder-access':
        $user =
            student_or_refuse(
                arg(
                    $args,
                    'username'
                )
            );

        $weeks =
            (int) arg(
                $args,
                'workshop_weeks',
                '1'
            );

        $examMode =
            arg(
                $args,
                'exam_mode',
                'open'
            );

        $examAt =
            (int) arg(
                $args,
                'exam_at',
                '0'
            );

        $assessmentMode =
            arg(
                $args,
                'assessment_mode',
                'open'
            );

        $assessmentAt =
            (int) arg(
                $args,
                'assessment_at',
                '0'
            );

        set_student_folder_access(
            $user,
            $weeks,
            $examMode,
            $examAt,
            $assessmentMode,
            $assessmentAt
        );

        audit(
            $admin,
            $ip,
            "updated folder access for {$user}: {$weeks} workshop week(s), exam={$examMode}, assessment={$assessmentMode}"
        );

        reply(
            student_folder_access($user)
        );

    case 'clear-student-folder':
        $user =
            student_or_refuse(
                arg(
                    $args,
                    'username'
                )
            );

        $area =
            arg(
                $args,
                'area'
            );

        if (!in_array($area, ['workshops', 'exam', 'assessment'], true)) {
            refuse('Choose Workshops, Exam, or Assessment.');
        }

        [$code, $out, $err] = run([
            CLEAR_FOLDER_TOOL,
            $user,
            $area
        ]);

        if ($code !== 0) {
            refuse(
                'Could not clear the folder: ' .
                trim($err ?: $out)
            );
        }

        audit(
            $admin,
            $ip,
            "cleared {$area} for {$user}"
        );

        reply([
            'username' => $user,
            'area' => $area
        ]);

    case 'remove-student':
        $user =
            student_or_refuse(
                arg(
                    $args,
                    'username'
                )
            );

        if (
            arg(
                $args,
                'confirm'
            ) !== $user
        ) {
            refuse(
                'Type the username exactly to confirm.'
            );
        }

        [
            $code,
            $out,
            $err
        ] = run([
            DEPLOY_ROOT .
            '/bin/remove-student.sh',
            '-u',
            $user,
            '--no-reload'
        ]);

        if ($code !== 0) {
            refuse(
                'Could not remove the student: ' .
                trim($err ?: $out)
            );
        }

        reload_later();

        audit(
            $admin,
            $ip,
            "removed student {$user}"
        );

        reply([
            'username' =>
                $user
        ]);

    case 'settings':
        $c = smtp();

        reply([
            'server_url' =>
                site_url(),
            'admin_email' =>
                (string) (
                    $c['admin_email'] ?? ''
                ),
            'email_domain' =>
                (string) (
                    $c['allowed_email_domain'] ?? ''
                ),
            'smtp_ready' =>
                (
                    $c['host'] ?? ''
                ) !== '' &&
                !str_contains(
                    (string) (
                        $c['host'] ?? ''
                    ),
                    'example'
                ),
            'students' =>
                count(
                    student_names()
                ),
            'default_quota_mb' =>
                DEFAULT_QUOTA_MB
        ]);

    case 'bans':
        reply(
            bans()
        );

    case 'unban':
        $jail =
            arg(
                $args,
                'jail'
            );

        $addr =
            arg(
                $args,
                'address'
            );

        if (
            !in_array(
                $jail,
                ['sshd', 'recidive'],
                true
            ) ||
            filter_var(
                $addr,
                FILTER_VALIDATE_IP
            ) === false
        ) {
            refuse(
                'Bad request.'
            );
        }

        [
            $code,
            $out,
            $err
        ] = run([
            'fail2ban-client',
            'set',
            $jail,
            'unbanip',
            $addr
        ]);

        if ($code !== 0) {
            refuse(
                'fail2ban said: ' .
                trim($err ?: $out)
            );
        }

        audit(
            $admin,
            $ip,
            "unbanned {$addr} ({$jail})"
        );

        reply([
            'address' =>
                $addr
        ]);

    case 'logs':
        reply(
            tail_log(
                arg(
                    $args,
                    'log',
                    'registration'
                ),
                (int) arg(
                    $args,
                    'lines',
                    '300'
                ),
                [
                    'time' => arg($args, 'time'),
                    'user' => arg($args, 'user'),
                    'event' => arg($args, 'event'),
                    'ip' => arg($args, 'ip')
                ]
            )
        );

    case 'allowlist':
        reply([
            'entries' =>
                allowlist(),
            'you' =>
                $ip
        ]);

    case 'allowlist-set':
        write_allowlist(
            preg_split(
                '/[\s,]+/',
                arg(
                    $args,
                    'entries'
                )
            ),
            $ip
        );

        audit(
            $admin,
            $ip,
            'changed the admin panel allowlist to: ' .
            implode(
                ' ',
                allowlist()
            )
        );

        reply([
            'entries' =>
                allowlist()
        ]);

    case 'test-email':
        $email =
            strtolower(
                arg(
                    $args,
                    'email'
                )
            );

        if (!valid_email($email)) {
            refuse(
                'That email address does not look right.'
            );
        }

        $err =
            send_mail(
                $email,
                '5CS045 server: test email',
                "This is a test email from the 5CS045 admin panel.\n\nIf you can read this, the server can send email."
            );

        if ($err !== null) {
            refuse(
                "The email could not be sent: {$err}"
            );
        }

        audit(
            $admin,
            $ip,
            "sent a test email to {$email}"
        );

        reply([
            'emailed' =>
                $email
        ]);

    case 'job-start':
        $kind =
            arg(
                $args,
                'kind'
            );

        if ($kind === 'remove-all') {
            $count =
                count(
                    student_names()
                );

            if ($count === 0) {
                refuse(
                    'There are no students to remove.'
                );
            }

            if (
                arg(
                    $args,
                    'confirm'
                ) !== "DELETE {$count}"
            ) {
                refuse(
                    "Type DELETE {$count} exactly to confirm."
                );
            }

            $params = [
                'count' =>
                    $count
            ];
        } elseif (
            $kind === 'bulk-add'
        ) {
            $params = [
                'emails' =>
                    substr(
                        arg(
                            $args,
                            'emails'
                        ),
                        0,
                        200000
                    ),
                'send_email' =>
                    !empty(
                        $args['send_email']
                    )
            ];

            if (
                trim(
                    $params['emails']
                ) === ''
            ) {
                refuse(
                    'Paste at least one email address.'
                );
            }
        } elseif (
            $kind === 'smoke-test'
        ) {
            $params = [];
        } else {
            refuse(
                'Unknown job.'
            );
        }

        $id =
            start_job(
                $kind,
                $params,
                $admin,
                $ip
            );

        audit(
            $admin,
            $ip,
            "started job {$id} ({$kind})"
        );

        reply([
            'id' =>
                $id
        ]);

    case 'job-status':
        reply(
            job_status(
                arg(
                    $args,
                    'id'
                )
            )
        );

    case 'jobs':
        $all =
            glob(
                JOB_DIR . '/*',
                GLOB_ONLYDIR
            ) ?: [];

        rsort($all);

        reply(
            array_map(
                fn($d) =>
                    array_diff_key(
                        job_status(
                            basename($d)
                        ),
                        ['log' => 1]
                    ),
                array_slice(
                    $all,
                    0,
                    10
                )
            )
        );

    default:
        refuse(
            'Unknown action.'
        );
}
